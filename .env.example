# Vite อ่านได้เฉพาะตัวแปรที่ขึ้นต้นด้วย VITE_
# ใช้ publishable key เท่านั้น ห้ามใส่ secret/service_role key
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# โดเมนของอีเมลสังเคราะห์ที่ใช้เป็นตัวตนล็อกอิน (username@<โดเมนนี้>) ผู้ใช้ไม่เห็นและไม่มีการส่งอีเมลจริง
# ต้องเป็นโดเมนจริงที่คุณเป็นเจ้าของ (ควรมี MX record) เพราะ Supabase ปฏิเสธโดเมนที่ไม่มีอยู่จริง เช่น .invalid
# ตั้งครั้งเดียวแล้วห้ามเปลี่ยนหลังมีผู้ใช้สมัครแล้ว ไม่เช่นนั้นทุกคนล็อกอินไม่ได้
VITE_AUTH_EMAIL_DOMAIN=your-domain.example
